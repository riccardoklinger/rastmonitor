# PostgreSQL
POSTGRES_DB=rastmonitor
POSTGRES_USER=rastmonitor
POSTGRES_PASSWORD=changeme

# Mobilithek SID endpoints (DATEX II SOAP)
STATIC_ENDPOINT=https://mobilithek.info:8443/mobilithek/api/v1.0/subscription/1006362396091736064/clientPullService?subscriptionID=1006362396091736064
DYNAMIC_ENDPOINT=https://mobilithek.info:8443/mobilithek/api/v1.0/subscription/1006362327707783168/clientPullService?subscriptionID=1006362327707783168

# Absolute path on the HOST to the .p12 client certificate file.
# Must be absolute — Docker Compose does not resolve relative paths here.
# Example: /Users/yourname/certs/client.p12
CERT_P12=/absolute/path/to/your/client.p12
P12_PASSWORD=yourp12password
# Optional override; default is BKG Grau. Use /api/map-style for self-hosted tiles.
#NEXT_PUBLIC_MAP_STYLE=https://sgx.geodatenzentrum.de/gdz_basemapde_vektor/styles/bm_web_gry.json

# OGC API Features base URL (pygeoapi)
PYGEOAPI_BASE_URL=https://rast-monitor.de/ogcapi

# GeoPackage download access (HTTP Basic auth; serve over HTTPS only).
# Leave empty to block downloads until credentials are configured.
DOWNLOAD_USERNAME=
DOWNLOAD_PASSWORD=

# Optional local HGV routing (docker compose --profile routing up -d ors).
# For a separate server, use its WireGuard address; this value is server-side only.
# ORS_URL=http://10.77.0.2:8088/ors
# Only a Germany extract is required; graph data is isolated in ors_graphs.
ORS_PBF=./routing/germany-latest.osm.pbf
ORS_XMS=1g
ORS_XMX=12g
ORS_MEMORY_LIMIT=16g
